#
# This systemd unit starts a flatnotes instance using Podman.
#
[Unit]
Description=flatnotes note-taking app

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# FLATNOTES_PASSWORD and FLATNOTES_SECRET_KEY, generated by create-module
# (secrets, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/flatnotes.pid %t/flatnotes.ctr-id
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/flatnotes.pid \
    --cidfile=%t/flatnotes.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --volume=data:/data:Z \
    --publish=127.0.0.1:${TCP_PORT}:8080 \
    --env=FLATNOTES_AUTH_TYPE=password \
    --env=FLATNOTES_USERNAME=admin \
    --env=FLATNOTES_PASSWORD \
    --env=FLATNOTES_SECRET_KEY \
    ${FLATNOTES_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/flatnotes.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/flatnotes.ctr-id
PIDFile=%t/flatnotes.pid
Type=forking

[Install]
WantedBy=default.target
