import os
import secrets

# Generate the credentials of the flatnotes "admin" user and the key that
# signs the login tokens. Secrets must not go through agent.set_env(),
# which stores values in Redis: keep them in a private file, included in
# the module backup (see etc/state-include.conf) and loaded by the
# systemd unit.
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"FLATNOTES_PASSWORD={secrets.token_hex(16)}\n")
    fp.write(f"FLATNOTES_SECRET_KEY={secrets.token_hex(32)}\n")
